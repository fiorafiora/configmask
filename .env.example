# Copy to .env and replace every value before the first start.
# The Fernet key decrypts the database. Losing it makes stored configs unreadable.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

CONFIGMASK_ADMIN_PASSWORD=change-me-now
CONFIGMASK_SECRET_KEY=replace-with-at-least-16-random-characters
CONFIGMASK_FERNET_KEY=replace-with-a-fernet-key

# Host port published by docker compose. The process inside the container
# listens on 8741; compose maps this value to that port.
CONFIGMASK_PORT=8741

# Set to 1 when a reverse proxy terminates HTTPS.
CONFIGMASK_COOKIE_SECURE=0

CONFIGMASK_DB_PATH=/data/configmask.db
CONFIGMASK_MAX_UPLOAD_BYTES=10485760
